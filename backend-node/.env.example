NODE_ENV=development
PORT=8080
TRADING_MODE=bybit_demo
PYTHON_ENGINE_URL=http://127.0.0.1:8001
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
PYTHON_READY_TIMEOUT_MS=8000
PYTHON_READY_ATTEMPTS=4
BYBIT_MARKET_BASE_URL=https://api.bybit.com
MARKET_REQUEST_TIMEOUT_MS=5000
MARKET_MAX_CLOCK_SKEW_MS=3000
MARKET_MAX_CANDLE_LAG_MS=90000
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
BYBIT_DEMO_RECV_WINDOW=5000
BYBIT_DEMO_REQUEST_TIMEOUT_MS=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-side-supabase-secret-key
SUPABASE_REQUEST_TIMEOUT_MS=8000
SIGNAL_WORKER_ENABLED=true
SIGNAL_WORKER_INTERVAL_MS=900000
SIGNAL_WORKER_INITIAL_DELAY_MS=30000
SIGNAL_WORKER_RUN_TIMEOUT_MS=780000
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MS=900000
WATCHDOG_INITIAL_DELAY_MS=90000
WATCHDOG_RUN_TIMEOUT_MS=60000
