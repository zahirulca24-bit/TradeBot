{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradebot.local/contracts/health.schema.json",
  "title": "TradeBot Health Response",
  "type": "object",
  "required": ["service", "status"],
  "properties": {
    "service": { "type": "string", "minLength": 1 },
    "status": { "enum": ["healthy", "degraded"] },
    "tradingMode": { "enum": ["bybit_demo", "unconfigured"] },
    "executionEnabled": { "type": "boolean" },
    "executionAuthority": { "type": "boolean" }
  },
  "additionalProperties": true
}
